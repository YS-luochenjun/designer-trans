{
  "$defs": {
    "DesignProfile": {
      "additionalProperties": false,
      "properties": {
        "workflow_id": {
          "anyOf": [
            {
              "$ref": "#/$defs/TaskKind"
            },
            {
              "type": "null"
            }
          ],
          "default": null
        },
        "source_set_policy": {
          "default": "provided_source_set",
          "enum": [
            "provided_source_set",
            "single_video"
          ],
          "title": "Source Set Policy",
          "type": "string"
        },
        "delivery_grouping": {
          "default": "locale_bundle",
          "enum": [
            "locale_bundle",
            "per_locale",
            "single_video"
          ],
          "title": "Delivery Grouping",
          "type": "string"
        },
        "review_policy": {
          "default": "source_locale_member_matrix",
          "enum": [
            "source_locale_member_matrix",
            "sample_then_full",
            "video_audiovisual",
            "external_result"
          ],
          "title": "Review Policy",
          "type": "string"
        },
        "sample_duration_seconds": {
          "default": 5,
          "enum": [
            3,
            5
          ],
          "title": "Sample Duration Seconds",
          "type": "integer"
        },
        "face_mask": {
          "default": "standard",
          "enum": [
            "standard",
            "tight"
          ],
          "title": "Face Mask",
          "type": "string"
        },
        "preserve_audio": {
          "default": true,
          "title": "Preserve Audio",
          "type": "boolean"
        },
        "target_selection": {
          "default": "reference_frame",
          "enum": [
            "reference_frame",
            "single_person"
          ],
          "title": "Target Selection",
          "type": "string"
        }
      },
      "title": "DesignProfile",
      "type": "object"
    },
    "FaceFusionProfile": {
      "additionalProperties": false,
      "properties": {
        "face_selector_mode": {
          "default": "reference",
          "enum": [
            "reference",
            "many",
            "one"
          ],
          "title": "Face Selector Mode",
          "type": "string"
        },
        "face_selector_order": {
          "default": "large-small",
          "enum": [
            "left-right",
            "right-left",
            "top-bottom",
            "bottom-top",
            "small-large",
            "large-small",
            "best-worst",
            "worst-best"
          ],
          "title": "Face Selector Order",
          "type": "string"
        },
        "reference_frame_number": {
          "default": 0,
          "minimum": 0,
          "title": "Reference Frame Number",
          "type": "integer"
        },
        "reference_face_position": {
          "default": 0,
          "minimum": 0,
          "title": "Reference Face Position",
          "type": "integer"
        },
        "reference_face_distance": {
          "default": 0.3,
          "maximum": 1,
          "minimum": 0,
          "title": "Reference Face Distance",
          "type": "number"
        },
        "face_mask_types": {
          "items": {
            "enum": [
              "box",
              "occlusion",
              "region"
            ],
            "type": "string"
          },
          "maxItems": 3,
          "minItems": 1,
          "title": "Face Mask Types",
          "type": "array"
        },
        "face_mask_blur": {
          "default": 0.3,
          "maximum": 1,
          "minimum": 0,
          "title": "Face Mask Blur",
          "type": "number"
        },
        "output_video_quality": {
          "default": 80,
          "maximum": 100,
          "minimum": 0,
          "title": "Output Video Quality",
          "type": "integer"
        },
        "target_preview_id": {
          "anyOf": [
            {
              "pattern": "^[0-9a-f]{32}$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Target Preview Id"
        }
      },
      "title": "FaceFusionProfile",
      "type": "object"
    },
    "ResourceBudget": {
      "additionalProperties": false,
      "properties": {
        "max_workspace_bytes": {
          "default": 2147483648,
          "exclusiveMinimum": 0,
          "maximum": 274877906944,
          "title": "Max Workspace Bytes",
          "type": "integer"
        },
        "max_workspace_files": {
          "default": 10000,
          "exclusiveMinimum": 0,
          "maximum": 200000,
          "title": "Max Workspace Files",
          "type": "integer"
        },
        "min_free_bytes": {
          "default": 1073741824,
          "minimum": 0,
          "title": "Min Free Bytes",
          "type": "integer"
        },
        "max_external_calls": {
          "default": 80,
          "maximum": 10000,
          "minimum": 0,
          "title": "Max External Calls",
          "type": "integer"
        },
        "max_recovery_calls": {
          "default": 8,
          "maximum": 1000,
          "minimum": 0,
          "title": "Max Recovery Calls",
          "type": "integer"
        },
        "max_clean_turns": {
          "default": 48,
          "maximum": 10000,
          "minimum": 0,
          "title": "Max Clean Turns",
          "type": "integer"
        }
      },
      "title": "ResourceBudget",
      "type": "object"
    },
    "TaskKind": {
      "enum": [
        "video_translation",
        "image_translation",
        "face_swap"
      ],
      "title": "TaskKind",
      "type": "string"
    }
  },
  "additionalProperties": false,
  "properties": {
    "max_kie_credits": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "number"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Max Kie Credits"
    },
    "max_paid_calls": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Max Paid Calls"
    },
    "max_video_credits": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Max Video Credits"
    },
    "max_image_calls": {
      "anyOf": [
        {
          "minimum": 0,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Max Image Calls"
    },
    "max_visual_steps": {
      "anyOf": [
        {
          "minimum": 4,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Max Visual Steps"
    },
    "title": {
      "maxLength": 200,
      "minLength": 1,
      "title": "Title",
      "type": "string"
    },
    "creation_request_id": {
      "anyOf": [
        {
          "maxLength": 128,
          "minLength": 16,
          "pattern": "^[A-Za-z0-9_-]+$",
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Creation Request Id"
    },
    "asset_ids": {
      "items": {
        "type": "string"
      },
      "maxItems": 20,
      "minItems": 1,
      "title": "Asset Ids",
      "type": "array"
    },
    "task_kind": {
      "$ref": "#/$defs/TaskKind",
      "default": "video_translation"
    },
    "target_locales": {
      "items": {
        "type": "string"
      },
      "maxItems": 12,
      "title": "Target Locales",
      "type": "array"
    },
    "target_locale_labels": {
      "items": {
        "type": "string"
      },
      "maxItems": 12,
      "title": "Target Locale Labels",
      "type": "array"
    },
    "facefusion": {
      "anyOf": [
        {
          "$ref": "#/$defs/FaceFusionProfile"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "design_profile": {
      "$ref": "#/$defs/DesignProfile"
    },
    "source_language": {
      "anyOf": [
        {
          "maxLength": 35,
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Source Language"
    },
    "notes": {
      "default": "",
      "maxLength": 8000,
      "title": "Notes",
      "type": "string"
    },
    "confirm_brief": {
      "default": false,
      "title": "Confirm Brief",
      "type": "boolean"
    },
    "profile": {
      "const": "default",
      "default": "default",
      "title": "Profile",
      "type": "string"
    },
    "max_revisions": {
      "default": 1,
      "maximum": 3,
      "minimum": 0,
      "title": "Max Revisions",
      "type": "integer"
    },
    "visual_route": {
      "default": "agent_adaptive",
      "enum": [
        "agent_adaptive",
        "solid_overlay",
        "wan_video_edit"
      ],
      "title": "Visual Route",
      "type": "string"
    },
    "audio_strategy": {
      "default": "preserve_background",
      "enum": [
        "preserve_background",
        "replace_all_audio"
      ],
      "title": "Audio Strategy",
      "type": "string"
    },
    "output_goal": {
      "default": "complete_candidate",
      "enum": [
        "complete_candidate",
        "quality_approved"
      ],
      "title": "Output Goal",
      "type": "string"
    },
    "allow_review_draft": {
      "default": false,
      "title": "Allow Review Draft",
      "type": "boolean"
    },
    "execution_profile": {
      "const": "efficient_v1",
      "default": "efficient_v1",
      "title": "Execution Profile",
      "type": "string"
    },
    "resource_budget": {
      "$ref": "#/$defs/ResourceBudget"
    }
  },
  "required": [
    "title",
    "asset_ids"
  ],
  "title": "TaskCreate",
  "type": "object",
  "$id": "urn:video-translation:tasks/task-create:1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
