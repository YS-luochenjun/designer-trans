{
  "additionalProperties": false,
  "properties": {
    "request_id": {
      "format": "uuid",
      "title": "Request Id",
      "type": "string"
    },
    "text": {
      "maxLength": 4000,
      "minLength": 1,
      "title": "Text",
      "type": "string"
    },
    "intent": {
      "default": "discussion",
      "enum": ["discussion", "storage", "cleanup_plan", "knowledge_summary"],
      "title": "Intent",
      "type": "string"
    },
    "task_id": {
      "anyOf": [
        {"pattern": "^[a-fA-F0-9]{32}$", "type": "string"},
        {"type": "null"}
      ],
      "default": null,
      "title": "Task Id"
    }
  },
  "required": ["request_id", "text"],
  "title": "ManagerMessage",
  "type": "object",
  "$id": "urn:video-translation:workflow/manager-message:1.0.0",
  "$schema": "https://json-schema.org/draft/2020-12/schema"
}
